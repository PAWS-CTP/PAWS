const knex = require('../knex');

class Pet{
  constructor({ id, name, rating, owner_id, breed}) {
    this.id = id;
    this.name = name;
    this.rating = rating;
    this.owner_id - owner_id;
    this.breed = breed;
  }

static async list() {
    try {
      const query = 'SELECT * FROM pets ORDER BY pets.created_at DESC';
      const { rows } = await knex.raw(query);
      return rows.map((pets) => new Pet(pets));
    } catch (err) {
      console.error(err);
      return null;
    }
  }
  static async find(id) {
    try {
      const query = 'SELECT * FROM pets WHERE id = ?';
      const { rows: [pet] } = await knex.raw(query, [id]);
      return pet ? new Pet(pet) : null;
    } catch (err) {
      console.error(err);
      return null;
    }
  }

  static async create(id, name, rating, owner_id, breed) {
    try {
      const query = `INSERT INTO pets (name, rating, owner_id, breed)
        VALUES (?, ?, ?, ?) RETURNING *`;
      const { rows: [pet] } = await knex.raw(query, [name, rating, owner_id, breed]);
      return new Pet(pet);
    } catch (err) {
      console.error(err);
      return null;
    }
  }
  update = async (caption) => { 
    try {
      const [updatedPet] = await knex('pets')
        .where({ id: this.id })
        .update({ caption })
        .returning('*');
      return updatedPet ? new Pet(updatedPet) : null;
    } catch (err) {
      console.error(err);
      return null;
    }
  };

  static async delete(id) {
    try{
      await knex.raw(`DELETE FROM posts WHERE pet_id = ?`,[ id ])
      const deleted = await knex.raw(`DELETE FROM pets WHERE id = ? RETURNING *;`,[ id ])
      return deleted.rowCount
    }
    catch (err){
      console.log(err)
      return null;
    }
  }

}

module.exports = Pet;
